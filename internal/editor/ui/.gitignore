node_modules
*.log
.DS_Store
.vite
*.tsbuildinfo

# Built UI bundle — generated by `npm run build`, embedded via //go:embed all:dist.
# Not tracked (generated/minified). Run `npm run build` before `go build`/`go test`
# so the real bundle is embedded; .gitkeep keeps the dir present so go:embed resolves.
dist/*
!dist/.gitkeep
